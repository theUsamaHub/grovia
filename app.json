{
  "expo": {
    "name": "Grovia",
    "slug": "grovia",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "grovia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/grovia-adaptive.png",
        "backgroundColor": "#2F6B4F"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/grovia-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6EF",
          "dark": {
            "backgroundColor": "#17251D"
          },
          "image": "./assets/images/grovia-adaptive.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/grovia-icon.png"
  }
}
